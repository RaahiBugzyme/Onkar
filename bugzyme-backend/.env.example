# Database connection used by the FastAPI application.
DATABASE_URL=postgresql+psycopg2://username:password@localhost/raahi_db

# Authentication
SECRET_KEY=your-secret-key-here-min-32-chars
TOKEN_TTL_HOURS=24

# CORS; set this to the frontend origin(s) for your environment.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000

# Attachments are stored under this backend-relative directory by default.
ATTACHMENT_STORAGE_DIR=storage/attachments
RAAHI_VERIFICATION_STORAGE_DIR=storage/private_verification

# Required to encrypt private verification evidence. Generate a fresh key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep the generated key private and do not commit it.
RAAHI_VERIFICATION_FERNET_KEY=replace-with-a-new-generated-fernet-key

# Optional AI provider configuration. Leave unset if not using Groq.
# GROQ_API_KEY=your-groq-api-key
